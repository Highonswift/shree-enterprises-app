STORYBLOK_PUBLIC_TOKEN=
STORYBLOK_PREVIEW_TOKEN=

# Region of the Storyblok space: eu, us, ca, ap or cn
STORYBLOK_REGION=eu

# Slug of the website page (story) in Storyblok
STORYBLOK_STORY_SLUG=site

# Space ID (Space settings). Also limits preview links to this space.
STORYBLOK_SPACE_ID=

# Publish webhook secret: a long random string. Also enter it in the Storyblok webhook.
STORYBLOK_WEBHOOK_SECRET=

# Setup script only. A personal access token that can change the space: never add it to Vercel.
STORYBLOK_MANAGEMENT_TOKEN=
