STORYBLOK_PUBLIC_TOKEN=
STORYBLOK_PREVIEW_TOKEN=

# Region of the Storyblok space: eu, us, ca, ap or cn
STORYBLOK_REGION=eu

# Slug of the website page (story) in Storyblok
STORYBLOK_STORY_SLUG=site

# Space ID (Space settings). Also limits preview links to this space.
STORYBLOK_SPACE_ID=

# Publish webhook secret: a long random string. Also enter it in the Storyblok webhook.
STORYBLOK_WEBHOOK_SECRET=

# Setup script only. A personal access token that can change the space: never add it to Vercel.
STORYBLOK_MANAGEMENT_TOKEN=

# Theme selector: "true" shows it on this deployment, including Vercel production. Always on in `npm run dev`.
# Read at build time: on Vercel, redeploy after changing it.
SHOW_THEME_SELECTOR=

# EmailJS (Project Enquiry form), set in .env or .env.local (.env.local wins, even if blank). Public identifiers only: never a private key or password.

# Built into the site, so set them before building and restart `npm run dev` after changes.

NEXT_PUBLIC_EMAILJS_SERVICE_ID=

NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

NEXT_PUBLIC_EMAILJS_PROJECT_TEMPLATE=
