# Used from Phase 4. Copy to .env.local and fill in there. Never commit real values.
# None of these may use the NEXT_PUBLIC_ prefix: that would expose them to the browser.

# Storyblok access tokens (Space settings > Access Tokens)
STORYBLOK_PUBLIC_TOKEN=
STORYBLOK_PREVIEW_TOKEN=

# Region of the Storyblok space: eu, us, ca, ap or cn
STORYBLOK_REGION=eu
